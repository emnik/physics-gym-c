  "questions": [
    {
      "type": "single_choice",
      "text": "Σύμφωνα με το νόμο του Faraday, η επαγωγική ΗΕΔ σε ένα κύκλωμα είναι ανάλογη:",
      "options": [
        "Της μαγνητικής ροής που το διαπερνά.",
        "Της ταχύτητας μεταβολής της μαγνητικής ροής.",
        "Της έντασης του μαγνητικού πεδίου.",
        "Της αντίστασης του κυκλώματος."
      ],
      "correct_answers": [
        1
      ],
      "explanation": "Σωστό το (β). Η ΗΕΔ καθορίζεται από τον ρυθμό μεταβολής της ροής: $E_{επ} = -N\\frac{\\Delta\\Phi}{\\Delta t}$.",
      "isEnabled": true
    },
    {
      "type": "single_choice",
      "text": "Η μονάδα μέτρησης της μαγνητικής ροής στο S.I. είναι το:",
      "options": [
        "Tesla (T)",
        "Weber (Wb)",
        "Henry (H)",
        "Volt (V)"
      ],
      "correct_answers": [
        1
      ],
      "explanation": "Σωστό το (β). Η μαγνητική ροή μετριέται σε Weber ($1\\ \\mathrm{Wb} = 1\\ \\mathrm{T} \\cdot \\mathrm{m}^2$).",
      "isEnabled": true
    },
    {
      "type": "single_choice",
      "text": "Ο κανόνας του Lenz επιτρέπει τον προσδιορισμό:",
